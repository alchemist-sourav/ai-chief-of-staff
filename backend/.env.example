# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30.0

# Database Configuration
# Production / Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/chief_of_staff
# SQLite async fallback (default for zero-setup local dev & tests):
DATABASE_URL=sqlite+aiosqlite:///./chief_of_staff.db
DB_ECHO=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Security
SECRET_KEY=development-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
